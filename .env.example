# このファイルを .env.local という名前でコピーし、値を入れてください（.env.local は Git に含まれません）。
# 値を変更したら npm start / npm run deploy をやり直す必要があります（ビルド時に埋め込まれるため）。

# Google Cloud Console で発行した API キー（HTTP リファラー制限 + Calendar API 限定にしておくこと）
REACT_APP_GOOGLE_CALENDAR_API_KEY=

# Google カレンダーの「設定と共有」→「カレンダーの統合」にあるカレンダー ID
# 例: abcdef123456@group.calendar.google.com
REACT_APP_GOOGLE_CALENDAR_ID=
